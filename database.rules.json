        ".write": "auth != null && (auth.token.email === 'surya@roboden.in' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "orders": {
      ".read": "auth != null && (auth.token.email === 'surya@roboden.in' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
